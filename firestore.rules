rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Collection: properties
    match /properties/{propertyId} {
      allow read: if resource.data.get('status', 'available') in ['available', 'pending', 'sold', 'rented']
                  || (isSignedIn() && resource.data.get('agentId', 'unassigned') == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.get('agentId', 'unassigned') == request.auth.uid || resource.data.get('agentId', 'unassigned') == 'unassigned');
      allow delete: if isSignedIn() && resource.data.get('agentId', 'unassigned') == request.auth.uid;
    }

    // Collection: agents
    match /agents/{agentId} {
      allow read: if resource.data.get('active', true) == true || (isSignedIn() && agentId == request.auth.uid);
      allow write: if isSignedIn() && agentId == request.auth.uid;
    }

    // Collection: locations
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collection: articles
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collection: agreements
    match /agreements/{agreementId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('agentId', '') == request.auth.uid);
    }

    // Collection: viewings
    match /viewings/{viewingId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('agentId', '') == request.auth.uid);
    }

    // Collection: favorites
    match /favorites/{favoriteId} {
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

    // Collection: leads
    match /leads/{leadId} {
      allow create: if true; // Public contact form / property inquiries
      allow read, update, delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('agentId', '') == request.auth.uid);
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && userId == request.auth.uid;
    }

    // Collection: notifications
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

    // Collection: aiConversations
    match /aiConversations/{conversationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
    }
  }
}

# Supabase Public Configuration (safe for client-side Vite bundle)
# Never place your Supabase service_role key here.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Public Canonical Application URL (used for SEO metadata, OAuth callbacks, and sitemaps)
APP_URL="https://www.amaanestate.com"

# Google Search Console OAuth2 Credentials (Server-side only — never expose to Vite client)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Optional Supabase Service Role Key (Server-side only — enables server-side GSC token & audit persistence)
SUPABASE_SERVICE_ROLE_KEY=""

